From 11a1b59699c57202a6c020bc9231aa7ca110deb8 Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Sun, 11 Oct 2026 10:30:45 +0800
Subject: [PATCH 17/19] wifi: rtl8192f-soc: record what a transmit halt leaves
 observable

The halt detector can only say that a ring stopped being consumed, and on
this board that is the least of what happens: over the sixteen halts
declared so far the channel was nearly free (0.3-23% of the sample window
busy), the in-core scheduler still accepted an H2C command, and no AXI
exception latched.  What a halt leaves behind is therefore recorded here
rather than explained, so that the numbers can be read by someone who has
the board in front of them.

The registers a halt is read out of: the 8197F AXI exception cause and
timestamp pair, which name the bus master and the timeout that produced a
latch and which the vendor tree never reads; the TX FIFO page ledger, an
assigned/available pair per priority queue, which answers whether a queue
that stopped still has any page it could be given - VO and BE share one
queue on this chip, and mainline rtw88 asks the same question of the
matching pair in REG_RQPN and REG_FIFOPAGE_CTRL_2 before it treats a queue
as drained; HISR1, read but deliberately not written back, because it is
write-1-to-clear and the interrupt handler owns those bits; and the ring
length, queue map and retry programming that would have to be wrong for the
engine to refuse ordinary work.  The heartbeat also clears the HISR0
latches that no host path consumes, so that the halt-time value names an
event since the previous heartbeat rather than a history since boot.  A
declared halt prints those next to the raw index pair of every ring, how
many descriptors each ring still owes the engine, the BBP channel loading,
a transmit-report request whose answer never reaches the host on this
chip, and the stalled descriptor beside the last consumed one.

The page ledger is printed on the passes that only flag a ring as well, the
four between the first descriptor the engine leaves behind and the
declaration.  That window is what separates a queue that cannot be given a
page from a fetch engine that stopped asking, and it is printed even when
another queue's progress makes the detector drop its counter, because a
stall that gets masked is itself a fact about the chip.

Alongside it the hardware's own account of releasing those pages: the two
gates in FWHW_TXQ_CTRL that let a boundary write set the free tail and let
the beacon download rewrite the beacon header page, the CPU management
queue's free tail, and that header page itself.  The vendor tree has no
reader for any of them, and the beacon path read-modify-writes the gate
register, so a halt and a heartbeat both record what it holds.  The TXREQ
clear-disable gate and the in-core CPU-clock bit go with them: both are
re-armed by the open path, so a queue that stays published and unfetched
after a restart can be told apart from one whose gate was switched off
behind us.

The frame class of each pending descriptor is printed too, because that is
what a halt means operationally: thirteen of the sixteen halts stalled the
best-effort ring, with ordinary QoS data of 62 to 1542 bytes pending,
aggregated or not, at either channel width; three stalled the management
ring, which is an access point that cannot answer a station trying to
join.

A heartbeat every 30 passes prints the same readings in normal operation,
bracketed so that a board which stops without a word leaves a gap naming
the pass that never finished.  One such death is recorded on this board so
far: no oops and no restart message, only the boot code reporting a
watchdog timeout afterwards.  Sampling the channel loading on every pass
lengthens a pass from 2.08 s to 2.172 s, so a declaration arrives about a
second later, which is the price of having the loading measured while the
ring was still being served rather than only after it stopped.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../net/wireless/realtek/rtl8192f-soc/hw.c    |   1 -
 .../realtek/rtl8192f-soc/rtl8192f_soc.h       |  64 ++-
 .../net/wireless/realtek/rtl8192f-soc/txrx.c  | 411 +++++++++++++++++-
 3 files changed, 466 insertions(+), 10 deletions(-)

--- a/drivers/net/wireless/realtek/rtl8192f-soc/hw.c
+++ b/drivers/net/wireless/realtek/rtl8192f-soc/hw.c
@@ -620,7 +620,6 @@ static void rtl8192f_apply_rf_table(stru
  * it no TX queue owns any FIFO pages and the first transmitted frame
  * raises TX FIFO overflow (TXFOVW).
  */
-#define REG_FIFOPAGE_INFO(i)	(0x0230 + ((i) * 4))
 #define REG_RQPN_CTRL_2		0x022c	/* trigger byte at +3 */
 #define REG_AUTO_LLT		0x0208
 #define REG_FWHW_TXQ_CTRL	0x0420
--- a/drivers/net/wireless/realtek/rtl8192f-soc/rtl8192f_soc.h
+++ b/drivers/net/wireless/realtek/rtl8192f-soc/rtl8192f_soc.h
@@ -178,11 +178,16 @@
 #define REG_HMETFR			0x01CC
 #define REG_HMEBOX(n)			(0x01D0 + (n) * 4)
 #define REG_HMEBOX_EXT(n)		(0x01F0 + (n) * 4)
-/* AXI bus exception cause / timestamp (8197F only, halmac_reg2.h
- * 2683-2684, bits halmac_bit2.h 32849-32885: DECERR/SLVERR R/W and
- * AXI_RXDMA_TIMEOUT).  Vendor never reads them; a non-zero value here
- * names the bus master and address that wedged the SoC.
- */
+/* AXI bus exception cause / timestamp, 8197F only (halmac_reg2.h
+ * 2683-2684 REG_AXI_EXCEPT_CS/_TIME, fields halmac_bit2.h 32849-32885:
+ * CS bits[5:0] are the latched causes - SLVERR on read/write, DECERR on
+ * read/write, TXDMA and RXDMA timeout - bits[13:8] gate their interrupts,
+ * and TIME carries the two 12-bit timeout values plus an 8-bit recovery
+ * time.  The vendor tree never reads either register.
+ */
+#define REG_AXI_EXCEPT_CS		0x1350
+#define REG_AXI_EXCEPT_TIME		0x1354
+#define AXI_CAUSE_MASK			0x3f	/* CS[5:0]: the six latched causes */
 #define REG_TXDMA_OFFSET_CHK		0x020C
 #define REG_RXDMA_STATUS		0x0288
 #define REG_RXDMA_MODE		0x0290
@@ -285,6 +290,42 @@
  * arbitrated away and never grants TXREQ (pages never drain).
  */
 #define REG_DIS_TXREQ_CLR		0x0523
+/* TX FIFO page ledger, one word per priority queue (halmac_reg2.h:823-831,
+ * guarded for HALMAC_8197F_SUPPORT; fields in halmac_bit2.h 17639-17720):
+ * bits 11:0 are the pages assigned to that queue - the same value
+ * rtl8192f_hw_fifo_init() writes at bring-up - and bits 27:16 are the vendor's
+ * *_AVAL_PG_V1, how many of them are available right now.  So a drained queue
+ * reads available == assigned and a starved one reads available == 0.  Which AC
+ * lands in which queue is what REG_TRXDMA_CTRL's map says: on this board VO+BE
+ * share NPQ and VI+BK share LPQ, MGQ takes EPQ and HIQ takes HPQ
+ * (Hal88XXGen.c 4761-4768, 8197F branch, whose comments name exactly that).
+ * Mainline rtw88 asks the same question of a different pair of registers -
+ * REG_RQPN (0x0200, reserved) against REG_FIFOPAGE_CTRL_2 (0x0204, available),
+ * drained when they are equal (mac.c __rtw_mac_flush_prio_queue).
+ */
+#define REG_FIFOPAGE_INFO(i)		(0x0230 + ((i) * 4))
+#define REG_FIFOPAGE_NUM		5
+#define PQ_PG_CNT			GENMASK(11, 0)
+#define PQ_AVAL_PG			GENMASK(27, 16)
+/* The page the beacon queue's header starts on (halmac_reg2.h:738
+ * REG_FIFOPAGE_CTRL_2; rtw88 reg.h:322).  With FWHW_TXQ_CTRL bit22 set the
+ * hardware rewrites this word from its own "tx free tail" as pages are
+ * released, so the value a driver put there is only good until the next
+ * release - which is why the firmware download parks bit22 first
+ * (rtl8192f_fw.c).  Read back, it says whether that rewrite happened while a
+ * halt was up.
+ */
+#define REG_FIFOPAGE_CTRL_2		0x0204
+/* CPU management-queue information (halmac_reg2.h:1160).  Bits 11:0 are
+ * BIT_FW_FREE_TAIL_V1 (halmac_bit2.h 20910-20916, in the block guarded for
+ * HALMAC_8197F_SUPPORT); the older generation's comment names the register
+ * "TXPKTBUF Packet Empty" (8192c_reg.h:189).  It is the tail the in-core
+ * scheduler has finished with, and the vendor tree has no reader for it, so
+ * it is the only place that can answer "did the page credit stop coming back"
+ * as opposed to "did the engine stop asking".
+ */
+#define REG_CPU_MGQ_INFO		0x041C
+#define FW_FREE_TAIL			GENMASK(11, 0)
 /* Channel loading measurement: the BBP times CCA-busy itself over a window
  * the host programs in 4 us units, arms it through 0x890 (reset, then arm,
  * then start) and leaves the count in 0x8d0 with 0x8b4 bit16 as the valid
@@ -965,6 +1006,19 @@ struct rtl8192f_soc_priv {
 	u32 tx_recoveries;
 	unsigned long tx_last_recover;
 
+	/* Watch passes since the ring was (re)armed.  Every
+	 * RTL8192F_TX_WATCH_BEATS of them the work prints a console line, so
+	 * that a board which dies without a word - the silent, watchdog-ended
+	 * case - leaves a gap that names the pass which never finished.
+	 */
+	u32 tx_ticks;
+	/* Channel loading seen by the BBP, accumulated over one heartbeat
+	 * interval: the busiest sample and how many samples it is over
+	 * (see rtl8192f_tx_watch()).
+	 */
+	u32 tx_busy_max_us;
+	u32 tx_busy_samples;
+
 	bool hw_ready;
 	bool running;
 	u32 cur_channel;
--- a/drivers/net/wireless/realtek/rtl8192f-soc/txrx.c
+++ b/drivers/net/wireless/realtek/rtl8192f-soc/txrx.c
@@ -1813,6 +1813,8 @@ void rtl8192f_rx_isr(struct rtl8192f_soc
  * (PENDING_PERIOD, 8192cd.h:3427).
  */
 #define RTL8192F_TX_WATCH_STALLS	5
+/* Console heartbeat period, in watch passes (2 s each). */
+#define RTL8192F_TX_WATCH_BEATS		30
 
 /* Channel loading over a window, in microseconds.
  *
@@ -1878,6 +1880,114 @@ static unsigned int rtl8192f_channel_bus
  * engine's consumer index, the lower half the one we published, so which
  * rings are behind and by how much is readable without arithmetic.
  */
+/* Name the 802.11 frame a published slot carries.
+ *
+ * Which frame class is jammed is part of what a halt means - one stubborn
+ * Action frame is a different fault from the queue having nothing it is
+ * allowed to send - and the raw descriptor bytes cannot say it.  The frame
+ * starts RTL8192F_TX_INFO_DESC_SIZE past skb->data, which is how the tx path
+ * lays the skb out (rtl8192f_tx_fill_desc()).
+ *
+ * The kernel's IEEE80211_STYPE_* are subtype fields without the type bits, so
+ * each case here has to carry its IEEE80211_FTYPE_* - IEEE80211_STYPE_RTS and
+ * IEEE80211_STYPE_AUTH are both 0x00b0 and only the type separates an RTS from
+ * an Authentication frame.  Anything unnamed still prints its raw fc.
+ */
+static const char *rtl8192f_frame_name(u16 fc)
+{
+	switch (fc & IEEE80211_FCTL_TYPE) {
+	case IEEE80211_STYPE_ASSOC_REQ:
+		return "assoc-req";
+	case IEEE80211_STYPE_ASSOC_RESP:
+		return "assoc-resp";
+	case IEEE80211_STYPE_REASSOC_REQ:
+		return "reassoc-req";
+	case IEEE80211_STYPE_REASSOC_RESP:
+		return "reassoc-resp";
+	case IEEE80211_STYPE_PROBE_REQ:
+		return "probe-req";
+	case IEEE80211_STYPE_PROBE_RESP:
+		return "probe-resp";
+	case IEEE80211_STYPE_DISASSOC:
+		return "disassoc";
+	case IEEE80211_STYPE_AUTH:
+		return "auth";
+	case IEEE80211_STYPE_DEAUTH:
+		return "deauth";
+	case IEEE80211_STYPE_ACTION:
+		return "action";
+	case IEEE80211_FTYPE_CTL | IEEE80211_STYPE_RTS:
+		return "rts";
+	case IEEE80211_FTYPE_CTL | IEEE80211_STYPE_CTS:
+		return "cts";
+	case IEEE80211_FTYPE_CTL | IEEE80211_STYPE_BACK:
+		return "block-ack";
+	case IEEE80211_FTYPE_CTL | IEEE80211_STYPE_BACK_REQ:
+		return "block-ack-req";
+	case IEEE80211_FTYPE_DATA | IEEE80211_STYPE_DATA:
+		return "data";
+	case IEEE80211_FTYPE_DATA | IEEE80211_STYPE_QOS_DATA:
+		return "qos-data";
+	case IEEE80211_FTYPE_DATA | IEEE80211_STYPE_NULLFUNC:
+		return "null";
+	case IEEE80211_FTYPE_DATA | IEEE80211_STYPE_QOS_NULLFUNC:
+		return "qos-null";
+	default:
+		return "unnamed";
+	}
+}
+
+/* The TX FIFO page ledger, one "name=free/owned" pair per priority queue.
+ * This is the reading that separates "the engine cannot fetch because it has
+ * no pages left" from "the engine has pages and still will not fetch": the
+ * first is a credit problem in the path that returns them, the second is not.
+ * Printed on every heartbeat as well, because a halt-time number only means
+ * something against a same-build baseline taken while the ring was served.
+ */
+static void rtl8192f_tx_page_ledger(struct rtl8192f_soc_priv *priv, char *buf,
+				    size_t size)
+{
+	static const char *const pq_name[REG_FIFOPAGE_NUM] = {
+		"hpq", "lpq", "npq", "epq", "pubq",
+	};
+	size_t off = 0;
+	int i;
+
+	for (i = 0; i < REG_FIFOPAGE_NUM; i++) {
+		u32 v = rtl8192f_read32(priv, REG_FIFOPAGE_INFO(i));
+
+		off += scnprintf(buf + off, size - off, " %s=%lu/%lu",
+				 pq_name[i], FIELD_GET(PQ_AVAL_PG, v),
+				 FIELD_GET(PQ_PG_CNT, v));
+	}
+}
+
+/* The other half of the same question: the page ledger says how many pages a
+ * queue has, these say what the hardware last wrote back about releasing them.
+ * txq is FWHW_TXQ_CTRL - bit20 is the gate that lets a boundary write set the
+ * free tail, bit22 the beacon-download gate the firmware download parks; both
+ * are read-modify-written from the beacon path, so the halt and the heartbeat
+ * record what they actually hold.  free_tail is the CPU management queue's
+ * report of how far the in-core scheduler has finished with the buffer, and
+ * bcn_head is the beacon header page that bit22 lets the hardware rewrite.
+ * req is the TXREQ clear-disable gate (0x0523) and clk the in-core CPU clock
+ * bit (0x0008 bit14); rtl8192f_txrx_start() re-arms both on every open, so a
+ * ring that is published and never fetched while req has lost its 0x80, or
+ * while clk lacks bit14, names whoever switched the gate off behind us.
+ */
+static void rtl8192f_tx_tail_state(struct rtl8192f_soc_priv *priv, char *buf,
+				   size_t size)
+{
+	scnprintf(buf, size,
+		  " txq=0x%08x free_tail=0x%03lx bcn_head=0x%04x req=0x%02x clk=0x%08x",
+		  rtl8192f_read32(priv, REG_FWHW_TXQ_CTRL),
+		  FIELD_GET(FW_FREE_TAIL,
+			    rtl8192f_read32(priv, REG_CPU_MGQ_INFO)),
+		  rtl8192f_read16(priv, REG_FIFOPAGE_CTRL_2),
+		  rtl8192f_read8(priv, REG_DIS_TXREQ_CLR),
+		  rtl8192f_read32(priv, REG_SYS_CLK_CTRL));
+}
+
 static void rtl8192f_tx_halt_report(struct rtl8192f_soc_priv *priv, int stalled,
 				    u32 rp)
 {
@@ -1891,7 +2001,12 @@ static void rtl8192f_tx_halt_report(stru
 			    RTL8192F_NUM_TX_DESC;
 	bool have_desc = false, slot_ok, busy_valid;
 	char line[160];
-	int off, ret;
+	char pages[80];
+	char pend[80];
+	char tail[96];
+	size_t poff = 0;
+	int off, ret, n;
+	u32 i;
 	u8 q;
 
 	slot_ok = rp < RTL8192F_NUM_TX_DESC;
@@ -1903,19 +2018,63 @@ static void rtl8192f_tx_halt_report(stru
 		off += scnprintf(line + off, sizeof(line) - off, " %s=0x%08x",
 				 priv->tx_ring[q].name,
 				 rtl8192f_read32(priv, queue_regs_tbl[q].idx));
+		poff += scnprintf(pend + poff, sizeof(pend) - poff, " %s=%u",
+				  priv->tx_ring[q].name,
+				  (priv->tx_ring[q].head - priv->tx_ring[q].tail) &
+				  (RTL8192F_NUM_TX_DESC - 1));
 	}
 	dev_err(dev, "%s\n", line);
 
-	dev_err(dev,
-		"tx halt: pause=0x%02x cr=0x%04x txdma=0x%x rxdma=0x%x hisr=0x%08x/0x%08x fwisr=0x%x rxidx=0x%08x\n",
+	dev_err(dev, "tx halt: pause=0x%02x cr=0x%04x txdma=0x%x rxdma=0x%x\n",
 		rtl8192f_read8(priv, REG_TXPAUSE),
 		rtl8192f_read16(priv, REG_CR),
 		rtl8192f_read32(priv, REG_TXDMA_STATUS),
-		rtl8192f_read32(priv, REG_RXDMA_STATUS),
+		rtl8192f_read32(priv, REG_RXDMA_STATUS));
+	dev_err(dev, "tx halt: hisr=0x%08x/0x%08x fwisr=0x%x rxidx=0x%08x\n",
 		rtl8192f_read32(priv, REG_HISR0),
 		rtl8192f_read32(priv, REG_HISR1),
 		rtl8192f_read32(priv, REG_FWISR),
 		rtl8192f_read32(priv, REG_RXQ_RXBD_IDX));
+	rtl8192f_tx_page_ledger(priv, pages, sizeof(pages));
+	dev_err(dev, "tx halt pages:%s\n", pages);
+	dev_err(dev, "tx halt pending:%s\n", pend);
+	rtl8192f_tx_tail_state(priv, tail, sizeof(tail));
+	dev_err(dev, "tx halt tail:%s\n", tail);
+
+	/* Two more questions the line above cannot answer.
+	 *
+	 * Interrupt masks: our own header records that the per-AC TX-done
+	 * bits have to stay out of HIMR0 because the in-core scheduler
+	 * consumes them, and the ISR's RDU workaround reaches that register
+	 * with a read-modify-write that a concurrent mask update could undo.
+	 * So name the TX-done bits here instead of making a reader decode 0xfc.
+	 *
+	 * Queue configuration: ring lengths, the queue map and the beacon
+	 * engine are what the TX path needs intact to make progress; this is
+	 * what they hold at the moment the fetch stopped.  The values we
+	 * program live in rtl8192f_txrx_start() and hw.c.
+	 */
+	dev_err(dev, "tx halt irq: himr0=0x%08x himr1=0x%08x%s\n",
+		rtl8192f_read32(priv, REG_HIMR0),
+		rtl8192f_read32(priv, REG_HIMR1),
+		(rtl8192f_read32(priv, REG_HIMR0) & RTL8192F_TX_DONE_MASK) ?
+			" (TX-DONE BITS ENABLED)" : "");
+	dev_err(dev,
+		"tx halt ringlen: mgnt=0x%04x rx=0x%04x vo=0x%04x vi=0x%04x be=0x%04x bk=0x%04x hi=0x%04x\n",
+		rtl8192f_read16(priv, REG_MGQ_TXBD_NUM),
+		rtl8192f_read16(priv, REG_RX_RXBD_NUM),
+		rtl8192f_read16(priv, REG_VOQ_TXBD_NUM),
+		rtl8192f_read16(priv, REG_VIQ_TXBD_NUM),
+		rtl8192f_read16(priv, REG_BEQ_TXBD_NUM),
+		rtl8192f_read16(priv, REG_BKQ_TXBD_NUM),
+		rtl8192f_read16(priv, REG_HI0Q_TXBD_NUM));
+	dev_err(dev,
+		"tx halt queue: map=0x%04x rwpclr=0x%08x retry=0x%02x bcn=0x%08x tbtt=0x%08x\n",
+		rtl8192f_read16(priv, REG_TRXDMA_CTRL),
+		rtl8192f_read32(priv, REG_BD_RWPTR_CLR),
+		rtl8192f_read8(priv, REG_RETRY_LIMIT),
+		rtl8192f_read32(priv, REG_BCN_CTRL),
+		rtl8192f_read32(priv, REG_MBSSID_BCN_SPACE));
 
 	/* Copy the descriptor bytes under the lock the reaper uses, and print
 	 * them after it: the liveness question below sleeps, and the skb this
@@ -1956,6 +2115,61 @@ static void rtl8192f_tx_halt_report(stru
 			rp, (int)sizeof(stuck_bd), &stuck_bd);
 	dev_err(dev, "tx halt: last consumed slot %u txbd %*ph\n", last,
 		(int)sizeof(last_bd), &last_bd);
+
+	/* The engine stopped at rp, but what matters is the class of frame it
+	 * will not take, so name the whole unpublished run rather than one
+	 * slot.  Four is enough to tell "one stubborn frame" from "everything
+	 * on this queue"; the skbs are stable because the reaper needs the
+	 * same lock this runs under.
+	 */
+	i = rp;
+	for (n = 0; n < 4 && i != (ring->head & (RTL8192F_NUM_TX_DESC - 1));
+	     n++) {
+		struct sk_buff *skb = ring->info[i].skb;
+		u16 fc;
+
+		if (!skb || skb->len <= RTL8192F_TX_INFO_DESC_SIZE + 1) {
+			dev_err(dev, "tx halt: slot %u has no frame to name\n",
+				i);
+			break;
+		}
+
+		fc = get_unaligned_le16(skb->data +
+					RTL8192F_TX_INFO_DESC_SIZE);
+		dev_err(dev, "tx halt: slot %u holds %s (fc 0x%04x, %u B)\n",
+			i, rtl8192f_frame_name(fc), fc,
+			skb->len - RTL8192F_TX_INFO_DESC_SIZE);
+		i = (i + 1) & (RTL8192F_NUM_TX_DESC - 1);
+	}
+}
+
+/* Name the latched AXI causes instead of printing a mask nobody can decode
+ * off a log line.  Bit order is halmac_bit2.h:32851-32856 (CS[5:0]).
+ */
+static void rtl8192f_axi_causes_str(u32 causes, char *out, size_t len)
+{
+	static const struct {
+		u32 bit;
+		const char *name;
+	} names[] = {
+		{ BIT(0), "slverr-r" },
+		{ BIT(1), "slverr-w" },
+		{ BIT(2), "decerr-r" },
+		{ BIT(3), "decerr-w" },
+		{ BIT(4), "txdma-timeout" },
+		{ BIT(5), "rxdma-timeout" },
+	};
+	size_t n = 0;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		if (!(causes & names[i].bit))
+			continue;
+		n += scnprintf(out + n, len - n, "%s%s", n ? "," : "",
+			       names[i].name);
+	}
+	if (!n)
+		scnprintf(out, len, "none");
 }
 
 /* Minimum spacing between two recovery restarts.
@@ -2017,15 +2231,100 @@ void rtl8192f_tx_watch(struct work_struc
 		container_of(to_delayed_work(work), struct rtl8192f_soc_priv,
 			     tx_watch);
 	unsigned long flags;
+	char causes_str[48];
+	char pages[80];
+	char tail[96];
+	char pend[80];
+	size_t pend_off;
+	bool armed = false, beat;
 	int stalled = -1;
 	int alive = 0;
+	int armed_q = -1;
+	u32 cs, axi_time, causes;
+	u32 be_idx, hisr0, hisr1;
 	u32 stalled_pending = 0, stalled_rp = 0;
+	u32 armed_stall = 0, armed_pend = 0, armed_rp = 0, armed_wp = 0;
 	u32 q;
 
 	if (!READ_ONCE(priv->running))
 		return;
 
+	/* Once any ring is being counted as stalled this tick is worth
+	 * bracketing: if the board dies inside a wifi MMIO read, the "pre"
+	 * line is the last thing the console ever gets, and that is the only
+	 * observation from this side that separates "the bus stopped answering"
+	 * from "the transmitter just stopped making progress".
+	 */
+	for (q = 0; q < Q_NUM; q++)
+		if (priv->tx_stall[q])
+			armed = true;
+
