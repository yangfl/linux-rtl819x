From 44e3117904eb12d2e04e6bae6a1f74b12065b3cd Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Mon, 21 Sep 2026 04:08:11 +0800
Subject: [PATCH 1/2] dt-bindings: timer: add Realtek RTL8197F timer

The RTL8197F has a timer block with a shared pre-divider (shared with
the watchdog), two timer channels and per-channel interrupt enable and
status bits.  TIMER0 drives the system clock event device: the CPU only
raises the CP0 Compare condition as Cause.TI and never asserts it on an
interrupt line, so a SoC timer is required for the system tick.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../timer/realtek,rtl8197f-timer.yaml         | 57 +++++++++++++++++++
 1 file changed, 57 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/timer/realtek,rtl8197f-timer.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/timer/realtek,rtl8197f-timer.yaml
@@ -0,0 +1,57 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/timer/realtek,rtl8197f-timer.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTL8197F SoC timer
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |
+  The RTL8197F contains a timer block with a shared pre-divider (which it
+  shares with the watchdog), two timer channels and per-channel interrupt
+  enable and status bits.  TIMER0 drives the system clock event device:
+  the CPU only raises the CP0 Compare condition as Cause.TI and never
+  asserts it on an interrupt line.
+
+  The register window includes the shared pre-divider (CDBR, +0x18).
+  This node owns CDBR and programs it for the timer input; the watchdog
+  node overlaps it at +0x18 but only reads the divider back.
+
+properties:
+  compatible:
+    const: realtek,rtl8197f-timer
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-frequency: true
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+oneOf:
+  - required: [clocks]
+  - required: [clock-frequency]
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    timer@3100 {
+        compatible = "realtek,rtl8197f-timer";
+        reg = <0x3100 0x20>;
+        interrupt-parent = <&intc>;
+        interrupts = <7 4>;
+        clock-frequency = <200000000>;
+    };
