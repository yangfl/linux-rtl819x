--- a/drivers/net/wireless/realtek/rtl8192f-soc/rtl8192f_soc.h
+++ b/drivers/net/wireless/realtek/rtl8192f-soc/rtl8192f_soc.h
@@ -406,6 +406,65 @@
 #define REG_MACID			0x0610	/* MACID[0] addr, 8B each */
 #define REG_BSSIDR			0x0618	/* BSSID, 6 bytes */
 
+/* Security CAM (HalComReg.h 1207-1211).  The entry RAM is not memory
+ * mapped: each of the 64 entries is 8 dwords and is reached one dword at
+ * a time through the write/data and read/data pair.  The command word is
+ * dword address (entry * 8 + dword) plus the polling request bit and, for
+ * a write, the write-enable bit; the polling bit stays set while the
+ * engine is busy, so it has to be observed clear before the next dword
+ * (CAMProgramEntry88XX / CAMFindUsable88XX, Hal88XXGen.c 46-98).
+ */
+#define REG_CAM_CMD			0x0670
+#define REG_CAM_WRITE			0x0674
+#define  CAM_CMD_POLLING		BIT(31)	/* BIT_SECCAM_POLLING */
+#define  CAM_CMD_WRITE_ENABLE		BIT(16)	/* BIT_SECCAM_WE */
+#define  CAM_DWORDS_PER_ENTRY		8	/* HAL_CAM_CONTENT_COUNT */
+/* HAL_CAM_CONTENT_USABLE_COUNT: two address dwords plus four key dwords. */
+#define  CAM_DWORDS_IN_USE		6
+/* total_cam_entry from 8192cd_osdep.c 3746-3749, the else branch that the
+ * 8197F takes.
+ */
+#define  CAM_ENTRIES			64
+/* Entries 0..3 stay reserved for group keys: with the engine's default-key
+ * search a multicast frame's key id indexes the entry directly (rtw88
+ * sec.c rtw_sec_get_free_cam() makes the same choice for the same reason),
+ * so pairwise keys are allocated from CAM_GROUP_ENTRIES upwards.
+ */
+#define  CAM_GROUP_ENTRIES		4
+/* DW0 low half: valid bit plus the algorithm and key id, exactly the
+ * combination CamAddOneEntry() builds (8192cd_hw.c 19245, with the
+ * algorithm passed already shifted by 2 - 8192cd_net80211.c 1064) and the
+ * same bit the vendor tests to decide whether an entry is free
+ * (CAMFindUsable88XX, Hal88XXGen.c 92-95).
+ */
+#define  CAM_CFG_VALID			BIT(15)
+#define  CAM_CFG_ALG_SHIFT		2
+#define  CAM_CFG_KEYID_MASK		0x3
+/* DOT11_ENC_ALGO (8192cd_security.h 116-124) */
+#define  CAM_ALG_NONE			0
+#define  CAM_ALG_CCMP			4
+
+/* Security engine configuration (REG_SECCFG, HalComReg.h 1211).  The
+ * vendor programs, for the hardware-crypto path, TXENC | RXDEC | NOSKMC |
+ * CHK_KEYID (CamAddOneEntry() -> HW_VAR_SECURITY_CONFIG, 8192cd_hw.c
+ * 19271-19283 with SCO_* from Wlan_TypeDef.h 40-50 mapped through
+ * HalComBit.h 18224-18230).  NOSKMC is what keeps a multicast frame from
+ * being decrypted by a CAM entry: this driver leaves group keys in
+ * software, like the vendor build does (set_gkey_to_cam = 0,
+ * 8192cd_security.c 621).
+ */
+#define REG_SECCFG			0x0680
+#define  SEC_CFG_TXENC			BIT(2)
+#define  SEC_CFG_RXDEC			BIT(3)
+#define  SEC_CFG_NOSKMC			BIT(5)
+#define  SEC_CFG_CHK_KEYID		BIT(8)
+/* REG_CR bit9, BIT_MAC_SEC_EN (HalComBit.h 8563): the MAC security engine
+ * has to be enabled for the CAM to be consulted at all;
+ * CAMProgramEntry88XX sets it as part of installing an entry
+ * (Hal88XXGen.c 229-232).
+ */
+#define  CR_MAC_SEC_EN			BIT(9)
+
 /* MACID Setting area / BSSIDR / RRSR / SLOT_TIME provenance:
  * vendor 8192c_reg.h (RTL8197_3411D_2 rtl8192cd).
  */
@@ -881,6 +940,22 @@ struct rtl8192f_soc_priv {
 	 */
 	u8 pd_threshold;
 
+	/* Security CAM bookkeeping (sec.c): which entries this driver holds.
+	 * The hardware cannot tell an entry of ours from one left by an
+	 * earlier boot, and a re-key only reaches the driver again when the
+	 * old key is deleted, so the allocation map has to live here.
+	 */
+	DECLARE_BITMAP(cam_map, CAM_ENTRIES);
+	/* Which key owns each CAM entry.  mac80211 hands the very same
+	 * ieee80211_key_conf back to set_key after a hardware restart
+	 * (ieee80211_reconfig() -> ieee80211_reenable_keys() ->
+	 * drv_set_key, net/mac80211/util.c:2264, net/mac80211/key.c:974)
+	 * without disabling it first, so the driver has to recognise its own
+	 * slot again; hw_key_idx cannot carry that on its own, because once
+	 * this key's slot was freed it can already belong to another key.
+	 */
+	struct ieee80211_key_conf *cam_owner[CAM_ENTRIES];
+
 	/* interface state (single-vif for now) */
 	struct ieee80211_vif *vif;
 	bool scanning;
@@ -1035,9 +1110,15 @@ void rtl8192f_sw_scan_start(struct ieee8
 			    struct ieee80211_vif *vif, const u8 *mac_addr);
 void rtl8192f_sw_scan_complete(struct ieee80211_hw *hw,
 			       struct ieee80211_vif *vif);
+/* sec.c: the hardware security CAM, reached only through the indirect
+ * command/data pair.  rtl8192f_sec_enable() also switches the engine on in
+ * REG_CR / REG_SECCFG, because the bring-up tables leave both at their
+ * reset values and .start() re-runs them after any key was installed.
+ */
 int rtl8192f_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 		     struct ieee80211_vif *vif, struct ieee80211_sta *sta,
 		     struct ieee80211_key_conf *key);
+void rtl8192f_sec_enable(struct rtl8192f_soc_priv *priv);
 void rtl8192f_bss_info_changed(struct ieee80211_hw *hw,
 			       struct ieee80211_vif *vif,
 			       struct ieee80211_bss_conf *info,
--- /dev/null
+++ b/drivers/net/wireless/realtek/rtl8192f-soc/sec.c
@@ -0,0 +1,242 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * RTL8192F-SoC mac80211 driver - hardware security engine
+ *
+ * The 8197F MAC holds up to 64 security CAM entries, each of 8 dwords, and
+ * the only way to any of them is the indirect command/data pair at
+ * 0x670/0x674 (write) and 0x678 (read).  An entry carries the peer address,
+ * the algorithm, the key id and 16 bytes of key material; once the engine is
+ * enabled the MAC looks an entry up by the frame's address and key id, adds
+ * the IV and the MIC on the way out and removes them on the way in, which is
+ * why the TX descriptor only has to name the algorithm.
+ */
+
+#include <linux/unaligned.h>
+
+#include "rtl8192f_soc.h"
+
+/* The polling request bit stays set while the engine works on the dword;
+ * the vendor bounds the wait at 10000 reads (CAMFindUsable88XX(),
+ * Hal88XXGen.c 78-90).
+ */
+#define CAM_POLL_LIMIT		10000
+
+static int rtl8192f_cam_poll(struct rtl8192f_soc_priv *priv)
+{
+	int retry = CAM_POLL_LIMIT;
+
+	while (rtl8192f_read32(priv, REG_CAM_CMD) & CAM_CMD_POLLING) {
+		if (!--retry)
+			return -ETIMEDOUT;
+		udelay(1);
+	}
+
+	return 0;
+}
+
+/* One dword write: data first, then the command word that names the dword
+ * and asks for the transfer (CAMProgramEntry88XX(), Hal88XXGen.c 206-226).
+ */
+static int rtl8192f_cam_write(struct rtl8192f_soc_priv *priv, u16 dword,
+			      u32 content)
+{
+	rtl8192f_write32(priv, REG_CAM_WRITE, content);
+	rtl8192f_write32(priv, REG_CAM_CMD,
+			 dword | CAM_CMD_POLLING | CAM_CMD_WRITE_ENABLE);
+
+	return rtl8192f_cam_poll(priv);
+}
+
+/* Mark an entry free.  A zero in dword 0 clears its valid bit, which is the
+ * test CAMFindUsable88XX() uses, and the vendor's empty routine covers all
+ * 8 dwords of the entry rather than the 6 that carry content
+ * (CAMEmptyEntry88XX(), Hal88XXGen.c 46-63).
+ */
+static void rtl8192f_cam_empty(struct rtl8192f_soc_priv *priv, u8 entry)
+{
+	u16 base = entry * CAM_DWORDS_PER_ENTRY;
+	int i;
+
+	for (i = 0; i < CAM_DWORDS_PER_ENTRY; i++)
+		if (rtl8192f_cam_write(priv, base + i, 0))
+			dev_err_ratelimited(&priv->pdev->dev,
+					    "CAM %u dword %d write timed out\n",
+					    entry, i);
+}
+
+/* Install a key.  Dwords go in from the top so the one carrying the address
+ * bytes 0-1 and the valid/config word lands last - an entry is never
+ * half-visible to the engine (CAMProgramEntry88XX() walks
+ * CAM_CONTENT_USABLE_COUNT-1 down to 0, Hal88XXGen.c 204-233).
+ */
+static int rtl8192f_cam_program(struct rtl8192f_soc_priv *priv, u8 entry,
+				const u8 *addr, const struct ieee80211_key_conf *key,
+				u16 config)
+{
+	u16 base = entry * CAM_DWORDS_PER_ENTRY;
+	u32 content;
+	int i;
+
+	for (i = CAM_DWORDS_IN_USE - 1; i >= 0; i--) {
+		if (i == 0) {
+			content = FIELD_PREP(GENMASK(31, 24), addr[1]) |
+				  FIELD_PREP(GENMASK(23, 16), addr[0]) |
+				  config;
+		} else if (i == 1) {
+			content = get_unaligned_le32(addr + 2);
+		} else {
+			/* dwords 2..5 carry the 16 key bytes; a shorter key
+			 * leaves the remaining bytes zero, which is what the
+			 * vendor's zero-padded key128 buffer produces for
+			 * WEP (CamAddOneEntry() passes that buffer straight
+			 * through, 8192cd_hw.c 19271).
+			 */
+			const u8 *p = key->key + (i - 2) * 4;
+
+			if ((i - 2) * 4 >= key->keylen) {
+				content = 0;
+			} else if (key->keylen - (i - 2) * 4 >= 4) {
+				content = get_unaligned_le32(p);
+			} else {
+				u8 tail[4] = { 0 };
+
+				memcpy(tail, p, key->keylen - (i - 2) * 4);
+				content = get_unaligned_le32(tail);
+			}
+		}
+
+		if (rtl8192f_cam_write(priv, base + i, content)) {
+			dev_err(&priv->pdev->dev,
+				"CAM %u dword %d write timed out\n", entry, i);
+			rtl8192f_cam_empty(priv, entry);
+			return -ETIMEDOUT;
+		}
+	}
+
+	return 0;
+}
+
+void rtl8192f_sec_enable(struct rtl8192f_soc_priv *priv)
+{
+	u32 val;
+
+	/* REG_CR is a 16-bit register here (see the CR RMWs in core.c), and
+	 * bit9 is inside that half.
+	 */
+	val = rtl8192f_read16(priv, REG_CR);
+	if (!(val & CR_MAC_SEC_EN))
+		rtl8192f_write16(priv, REG_CR, val | CR_MAC_SEC_EN);
+
+	/* TXENC | RXDEC | NOSKMC | CHK_KEYID, the set the vendor programs for
+	 * the hardware path (CamAddOneEntry() -> HW_VAR_SECURITY_CONFIG,
+	 * 8192cd_hw.c 19273-19283).  NOSKMC keeps multicast frames out of the
+	 * CAM search: this driver leaves group keys in software, exactly as
+	 * the shipped firmware does (set_gkey_to_cam = 0,
+	 * 8192cd_security.c 621).
+	 */
+	val = rtl8192f_read32(priv, REG_SECCFG);
+	rtl8192f_write32(priv, REG_SECCFG,
+			 val | SEC_CFG_TXENC | SEC_CFG_RXDEC |
+			 SEC_CFG_NOSKMC | SEC_CFG_CHK_KEYID);
+}
+
+/* The entry this key already owns, or -1 when it has none.
+ *
+ * Without this, a re-upload (mac80211 does one after every hardware restart)
+ * would take a fresh slot each time and leave the previous one programmed and
+ * unaccounted for: the pairwise range is CAM_ENTRIES - CAM_GROUP_ENTRIES
+ * entries wide, so a client that survived that many stalls would end up with
+ * its key handled in software while the orphaned entries still decrypt for
+ * addresses that no longer exist.
+ */
+static int rtl8192f_cam_slot(struct rtl8192f_soc_priv *priv,
+			     const struct ieee80211_key_conf *key)
+{
+	int i;
+
+	for (i = CAM_GROUP_ENTRIES; i < CAM_ENTRIES; i++)
+		if (priv->cam_owner[i] == key)
+			return i;
+
+	return -1;
+}
+
+/* Group keys stay in software, so only a pairwise CCMP key is installed in
+ * hardware; anything else returns 1 and mac80211 keeps handling it itself
+ * (return 1 for a key is the documented "software crypto for this key"
+ * answer - net/mac80211.h "Hardware crypto acceleration").
+ */
+int rtl8192f_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
+		     struct ieee80211_vif *vif, struct ieee80211_sta *sta,
+		     struct ieee80211_key_conf *key)
+{
+	struct rtl8192f_soc_priv *priv = hw->priv;
+	u16 config;
+	int entry;
+	int ret = 0;
+
+	mutex_lock(&priv->conf_mutex);
+
+	if (cmd == DISABLE_KEY) {
+		/* Only free a slot this key really owns: key->hw_key_idx
+		 * survives a disable, so after an entry has been handed to
+		 * another key the number alone can point at that other key.
+		 */
+		if (key->hw_key_idx < CAM_ENTRIES &&
+		    priv->cam_owner[key->hw_key_idx] == key &&
+		    test_and_clear_bit(key->hw_key_idx, priv->cam_map)) {
+			rtl8192f_cam_empty(priv, key->hw_key_idx);
+			priv->cam_owner[key->hw_key_idx] = NULL;
+			dev_dbg(&priv->pdev->dev, "CAM %u freed\n",
+				key->hw_key_idx);
+		}
+		goto out;
+	}
+
+	if (!sta || key->cipher != WLAN_CIPHER_SUITE_CCMP ||
+	    key->keylen != 16) {
+		ret = 1;
+		goto out;
+	}
+
+	entry = rtl8192f_cam_slot(priv, key);
+	if (entry < 0)
+		entry = find_next_zero_bit(priv->cam_map, CAM_ENTRIES,
+					   CAM_GROUP_ENTRIES);
+	if (entry >= CAM_ENTRIES) {
+		/* Out of pairwise slots: fall back to software for this peer
+		 * rather than evicting another peer's key.
+		 */
+		ret = 1;
+		goto out;
+	}
+
+	config = CAM_CFG_VALID |
+		 (CAM_ALG_CCMP << CAM_CFG_ALG_SHIFT) |
+		 FIELD_PREP(CAM_CFG_KEYID_MASK, key->keyidx);
+
+	ret = rtl8192f_cam_program(priv, entry, sta->addr, key, config);
+	if (ret)
+		goto out;
+
+	set_bit(entry, priv->cam_map);
+	priv->cam_owner[entry] = key;
+	key->hw_key_idx = entry;
+
+	/* The engine writes the CCMP header into the frame and appends the MIC,
+	 * so mac80211 has to leave room for both without filling them in
+	 * itself.  Same reason the vendor adds the IV length to the header
+	 * segment whenever a frame is hardware-encrypted: "CCMP: 1) iv is CCMP
+	 * header, 2) mic for hw encrypt" (SetTxBufferDesc88XX(),
+	 * Hal88XXTxDesc.c 1452-1460).
+	 */
+	key->flags |= IEEE80211_KEY_FLAG_PUT_IV_SPACE |
+		      IEEE80211_KEY_FLAG_RESERVE_TAILROOM;
+	rtl8192f_sec_enable(priv);
+	dev_dbg(&priv->pdev->dev, "CCMP key for %pM -> CAM %u (0x%04x)\n",
+		sta->addr, entry, config);
+
+out:
+	mutex_unlock(&priv->conf_mutex);
+	return ret;
+}
--- a/drivers/net/wireless/realtek/rtl8192f-soc/txrx.c
+++ b/drivers/net/wireless/realtek/rtl8192f-soc/txrx.c
@@ -129,6 +129,13 @@ static u16 queue_to_ac(u8 qidx)
 #define TXD_W1_QSEL			GENMASK(12, 8)
 #define TXD_W1_RATE_ID			GENMASK(20, 16)
 #define TXD_W1_PKT_OFFSET		GENMASK(28, 24)
+/* TX_DW1 [23:22] names the algorithm the engine must apply (HalComTXDesc.h
+ * 117/132 TX_DW1_SECTYPE, values 522-525).  There is no key index in the
+ * descriptor: the engine finds the CAM entry from the frame's address and
+ * key id, which is why set_key() stores the peer address with the key.
+ */
+#define TXD_W1_SEC_TYPE			GENMASK(23, 22)
+#define  TXD_SEC_TYPE_AES		3
 #define TXD_W2_G_ID			GENMASK(29, 24)
 #define TXD_W2_AGG_EN			BIT(12)	/* vendor TX_DW2_AGG_EN_SH */
 #define TXD_W2_AMPDU_DENSITY		GENMASK(22, 20)
@@ -168,6 +175,13 @@ static u16 queue_to_ac(u8 qidx)
 #define RXD_W0_PKT_LEN			GENMASK(13, 0)
 #define RXD_W0_CRC32_ERR		BIT(14)
 #define RXD_W0_ICV_ERR			BIT(15)
+/* RX_DW0 [22:20] names the algorithm the engine applied and bit27 says the
+ * frame was left to software (RX_DW0_SECURITY_SH / RX_DW0_SWDEC_SH,
+ * HalComRXDesc.h 74/78).  Together they are how rtw88 rx.c 286 decides a
+ * frame arrived decrypted.
+ */
+#define RXD_W0_SECURITY			GENMASK(22, 20)
+#define RXD_W0_SWDEC			BIT(27)
 #define RXD_W0_DRV_INFO_SIZE		GENMASK(19, 16)	/* in 8B units */
 #define RXD_W0_SHIFT			GENMASK(25, 24)
 /* DW3: RX_RATE is 7 bits (0-11 legacy linear, 12+ = MCS0+); there are
@@ -737,6 +751,22 @@ void rtl8192f_txrx_stop(struct rtl8192f_
 	priv->running = false;
 }
 
+/* Whether the security engine already took this frame apart: SWDEC says
+ * it was left for software and SECURITY names the algorithm applied
+ * (RX_DW0_SECURITY_SH / RX_DW0_SWDEC_SH, HalComRXDesc.h 74/78) - the
+ * same pair of fields rtw88 rx.c 286 tests.  CAM_ALG_NONE is the value
+ * a frame the engine did not touch reports.
+ */
+static bool rtl8192f_rx_hw_decrypted(__le32 rxdesc_w0)
+{
