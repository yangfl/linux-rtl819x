From eae215c34e78c91edba7519fb4be7fe76fcce6ba Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Mon, 21 Sep 2026 04:08:07 +0800
Subject: [PATCH 1/2] dt-bindings: spi: add Realtek RTL8197F SPI controller

The RTL8197F integrates a DesignWare SSI derived SPI controller with
flash-oriented extensions, unrelated to the controller in
the RTL838x/839x (Otto) switch SoCs despite the vendor naming.  It
drives the boot SPI NOR flash with single-lane, half-duplex transfers
and defaults to a single chip select (the schema allows up to 16).

The vendor flash extensions and transfer-engine behaviour make the
controller incompatible with a plain DesignWare SSI driven in
software, so the binding advertises no "snps,dw-apb-ssi" fallback
compatible and names the driver that handles them:
drivers/spi/spi-realtek-rtl819x.c reuses the DesignWare core but
replaces its mem-ops transfer engine, because a generic driver would
program CTRLR1.NDF as frame count minus one and trust RXFLR for the
received frame count, and both are wrong on this part.

The controller is clocked from the SoC clock controller, so clocks is
a required property and there is no ad-hoc clock-frequency property
(the DesignWare driver does not consume one); the SoC dtsi node points
at the clock provider.  The interrupt is documented as optional: the
driver runs the controller polled unless the board describes one.  The
example node takes its clock from the syscon's clock child and asks
for 12.5 MHz, the vendor-validated SPI clock divided by eight.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../bindings/spi/realtek,rtl8197f-spi.yaml         |  113 ++++++++++++++++++++
 1 file changed, 113 insertions(+)
 create Documentation/devicetree/bindings/spi/realtek,rtl8197f-spi.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/spi/realtek,rtl8197f-spi.yaml
@@ -0,0 +1,113 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/spi/realtek,rtl8197f-spi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTL8197F SPI flash controller
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |
+  The RTL8197F (and other RTL819x SoCs) contain a SPI flash controller
+  derived from the Synopsys DesignWare SSI, located at 0x18143000.  It is a
+  half-duplex, single-lane controller intended to drive a SPI NOR flash
+  chip, and works together with the SPI NOR framework (jedec,spi-nor).
+
+  The register layout follows the DesignWare APB SSI, but the transfer
+  engine carries vendor extensions and silicon quirks (flash-extension
+  registers, NDF frame-count semantics, unreliable RXFLR) which make it
+  incompatible with a plain DesignWare SSI in software.  It therefore
+  carries no "snps,dw-apb-ssi" fallback compatible and is driven by
+  drivers/spi/spi-realtek-rtl819x.c, which reuses the DesignWare core for the
+  host registration but replaces its mem-ops transfer engine.
+
+  This controller is unrelated to the simpler SPI flash controller found in
+  the Realtek Otto SoCs (RTL8380/8382/8391/8392/8393), which has a
+  completely different register layout and uses the "realtek,rtl8380-spi"
+  family of compatibles.
+
+allOf:
+  - $ref: spi-controller.yaml#
+
+properties:
+  compatible:
+    const: realtek,rtl8197f-spi
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  num-cs:
+    description: Number of chip selects, up to 16.
+    $ref: /schemas/types.yaml#/definitions/uint32
+    minimum: 1
+    maximum: 16
+    default: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - "#address-cells"
+  - "#size-cells"
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/realtek-rtl819x-clks.h>
+
+    syscon@18000000 {
+        compatible = "realtek,rtl8197f-syscon", "syscon", "simple-mfd";
+        reg = <0x18000000 0x200>;
+        #address-cells = <1>;
+        #size-cells = <1>;
+        ranges = <0x0 0x18000000 0x200>;
+
+        sysclk: clock-controller@0 {
+            compatible = "realtek,rtl8197f-clock";
+            reg = <0x0 0x68>;
+            #clock-cells = <1>;
+        };
+    };
+
+    spi0: spi@18143000 {
+        compatible = "realtek,rtl8197f-spi";
+        reg = <0x18143000 0x1000>;
+        clocks = <&sysclk RTL8197F_CLK_SPI>;
+        num-cs = <1>;
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        flash@0 {
+            compatible = "jedec,spi-nor";
+            reg = <0>;
+            /* the vendor-validated SPI clock / 8 */
+            spi-max-frequency = <12500000>;
+
+            partitions {
+                compatible = "fixed-partitions";
+                #address-cells = <1>;
+                #size-cells = <1>;
+
+                partition@0 {
+                    label = "boot";
+                    reg = <0x0 0x40000>;
+                    read-only;
+                };
+
+                partition@40000 {
+                    label = "firmware";
+                    reg = <0x40000 0x1fc0000>;
+                };
+            };
+        };
+    };
+...
