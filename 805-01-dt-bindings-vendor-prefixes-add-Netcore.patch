From a15a4c805ba6b69a81abd5a938bbbd7588f8d899 Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Mon, 21 Sep 2026 04:08:13 +0800
Subject: [PATCH 1/3] dt-bindings: vendor-prefixes: add Netcore

Add the vendor prefix for Netcore Technology Co., Ltd., a Chinese
networking equipment vendor.  Their MG1200AC router is based on the
Realtek RTL8197F.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 Documentation/devicetree/bindings/vendor-prefixes.yaml | 2 ++
 1 file changed, 2 insertions(+)

--- a/Documentation/devicetree/bindings/vendor-prefixes.yaml
+++ b/Documentation/devicetree/bindings/vendor-prefixes.yaml
@@ -1172,6 +1172,8 @@ patternProperties:
     description: Neofidelity Inc.
   "^neonode,.*":
     description: Neonode Inc.
+  "^netcore,.*":
+    description: Netcore Technology Co., Ltd.
   "^netcube,.*":
     description: NetCube Systems Austria
   "^netgear,.*":
