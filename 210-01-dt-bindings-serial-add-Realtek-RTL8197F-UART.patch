From 5e2e56b9c0130e577e08f7bc97e60b399361cdd4 Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Mon, 21 Sep 2026 04:08:04 +0800
Subject: [PATCH 1/2] dt-bindings: serial: add Realtek RTL8197F UART

The RTL8197F integrates a DesignWare APB UART whose TX/RX FIFO register
is placed at offset 0x24 instead of the standard 0x00, so it cannot be
described as a plain snps,dw-apb-uart.  Add a dedicated binding; the
interrupt reference is required (the SoC interrupt controller feeds
this port), while the input clock may either come from the clock provider
or
be stated with clock-frequency, so neither property is required: the SoC
dtsi uses the provider, and a board without one still has to be able to
describe the port.  reg-shift = 2 is the word stride the registers use.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../bindings/serial/realtek,rtl8197f-uart.yaml     |   59 ++++++++++++++++++++
 1 file changed, 59 insertions(+)
 create Documentation/devicetree/bindings/serial/realtek,rtl8197f-uart.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/serial/realtek,rtl8197f-uart.yaml
@@ -0,0 +1,59 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/serial/realtek,rtl8197f-uart.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTL8197F UART
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |
+  The RTL8197F integrates a DesignWare APB UART whose register file is
+  word-strided like a regular 8250 with reg-shift = 2, but the TX/RX
+  FIFO register is placed at offset 0x24 instead of 0x00, so it is not
+  covered by the generic snps,dw-apb-uart binding.
+
+allOf:
+  - $ref: serial.yaml#
+
+properties:
+  compatible:
+    const: realtek,rtl8197f-uart
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+    description:
+      UART input clock, from the SoC clock controller.  When absent the
+      8250 layer falls back to clock-frequency, which is what a board
+      without a clock provider has to use.
+
+  clock-frequency: true
+
+  reg-shift:
+    const: 2
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    serial@18147000 {
+        compatible = "realtek,rtl8197f-uart";
+        reg = <0x18147000 0x100>;
+        interrupts = <9 4>;
+        interrupt-parent = <&intc>;
+        clock-frequency = <100000000>;
+        reg-shift = <2>;
+    };
