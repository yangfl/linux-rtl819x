From 1a319e4b28b80328ab8e1174b3170d38fca1fbbd Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Mon, 21 Sep 2026 04:08:12 +0800
Subject: [PATCH 1/2] dt-bindings: net: add Realtek RTL8197F Ethernet MAC

The RTL8197F embeds a 5+1 port switch with a CPU-port DMA interface.
Add a binding for the CPU interface: it brings up the descriptor
rings only and expects the switch fabric itself (port enable, VLAN,
CPU-port mapping) to have been configured by the bootloader; the TX
destination port mask is selectable through realtek,tx-portmask.

The CPU-port link has to be described with either a fixed-link sub-node
(typical: the MAC is wired point-to-point to a switch CPU port over
RGMII) or a phy-handle.  The schema does not enforce the choice:
nothing in dt-schema expresses "one of fixed-link / phy-handle" for a
child-less port, so this stays prose plus example, and it is the
driver's probe that fails without one.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../bindings/net/realtek,rtl8197f-eth.yaml         |   87 ++++++++++++++++++++
 1 file changed, 87 insertions(+)
 create Documentation/devicetree/bindings/net/realtek,rtl8197f-eth.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/net/realtek,rtl8197f-eth.yaml
@@ -0,0 +1,87 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/realtek,rtl8197f-eth.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTL8197F Ethernet MAC / embedded switch CPU interface
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |
+  The RTL8197F integrates a 5+1 port Ethernet switch whose CPU port is served
+  by a DMA engine (the "NIC" or "CPU interface" block).  The MAC has no
+  per-port PHY management of its own: the embedded switch is expected to be
+  set up by the bootloader (port enable, VLAN / port isolation, CPU port
+  mapping), and this node only programs the DMA descriptor rings used to
+  exchange packets with the switch over the CPU port.
+
+  Packets received from the CPU port carry no Ethernet switch tag by default
+  and are directed by the switch configuration; the destination port mask
+  used on transmit can be selected with realtek,tx-portmask.
+
+  The MAC side of the CPU-port link is managed by phylink and the link must
+  be described with either a "fixed-link" sub-node (typical: the MAC is
+  wired point-to-point to a switch CPU port over RGMII) or a "phy-handle".
+
+properties:
+  compatible:
+    const: realtek,rtl8197f-eth
+
+  reg:
+    maxItems: 1
+    description:
+      CPU interface (NIC DMA) register block, offset 0x10000 from the system
+      controller base (physical 0x18010000 on RTL8197F).
+
+  reg-names:
+    const: nic
+
+  interrupts:
+    maxItems: 1
+    description:
+      Switch/CPU-interface interrupt on the SoC interrupt controller
+      (intc input 15, routed to CPU interrupt input 4).
+
+  realtek,tx-portmask:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 0x7f
+    description:
+      Destination port mask written to the Tx descriptor (TD_DP field,
+      bit 6 = CPU port, bits 5..0 = physical/ext. ports 5..0) for directly
+      transmitted packets when no hardware offload path is used.  If absent,
+      all switch ports (0x3f) are addressed, which relies on the bootloader
+      switch configuration to forward/flood appropriately.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+
+allOf:
+  - $ref: ethernet-controller.yaml#
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    ethernet@18010000 {
+      compatible = "realtek,rtl8197f-eth";
+      reg = <0x18010000 0x100>;
+      reg-names = "nic";
+      interrupt-parent = <&intc>;
+      interrupts = <15 1>;
+
+      realtek,tx-portmask = <0x1>;
+      local-mac-address = [00 11 22 33 44 55];
+
+      /* RGMII to a switch CPU port with no extra delays on either end */
+      phy-mode = "rgmii";
+      fixed-link {
+        speed = <1000>;
+        full-duplex;
+      };
+    };
+...
