From fd644736b2ee979669eb036265a0c5f051b01439 Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Mon, 21 Sep 2026 04:08:03 +0800
Subject: [PATCH 1/2] MIPS: add Realtek RTL819x platform support

The RTL819x family (RTL8196E/8197D/8197F, ...) is Realtek's wireless
router SoC line, distinct from the RTL83xx/93xx (Otto) switch SoCs
already running under the generic platform.  Take the same approach
for the RTL819x family, starting with the little-endian MIPS32R2
RTL8197F: the platform relies on the generic MIPS code with a device
tree, and SoC peripherals are described by DT and driven by their own
drivers.

The platform selects BUILTIN_DTB so that the kernel carries its own
device tree; RTL819x bootloaders do not pass one.  The SoC tick comes
from the on-chip TIMER0 through the
Realtek RTL819x clocksource driver; the r4k counter cannot raise an
interrupt on this SoC.

The board file is only the machine match table.  Everything else on this
SoC is a device tree node with its own driver, and restart belongs to the
watchdog driver, which registers the system restart handler and writes the
same global interrupt mask on the way out; a second handler here would only
duplicate it.

A defconfig for the RTL8197F and the MAINTAINERS entry land here as well.

Finally, select the hidden USB_EHCI/OHCI_BIG_ENDIAN_DESC options:
the RTL8197F USB host controllers use big-endian DMA descriptors, as
the DT properties of the USB host controllers declare once the USB
node lands.  MMIO word order stays little-endian, matching the CPU.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 MAINTAINERS                               |   7 +
 arch/mips/Kconfig                         |  26 ++++
 arch/mips/configs/rtl8197f_defconfig      | 168 ++++++++++++++++++++++
 arch/mips/generic/Makefile                |   1 +
 arch/mips/generic/board-realtek-rtl819x.c |  17 +++
 5 files changed, 219 insertions(+)
 create mode 100644 arch/mips/configs/rtl8197f_defconfig
 create mode 100644 arch/mips/generic/board-realtek-rtl819x.c

--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -22993,6 +22993,13 @@ S:	Maintained
 F:	Documentation/devicetree/bindings/net/pse-pd/realtek,pse-mcu-gen1.yaml
 F:	drivers/net/pse-pd/realtek-pse-mcu*
 
+REALTEK RTL819X SOC SUPPORT
+M:	David Yang <mmyangfl@gmail.com>
+S:	Maintained
+F:	Documentation/devicetree/bindings/mips/realtek-rtl819x.yaml
+F:	arch/mips/boot/dts/realtek/rtl8197f*
+F:	arch/mips/generic/board-realtek-rtl819x.c
+
 REALTEK RTL83xx SMI DSA ROUTER CHIPS
 M:	Linus Walleij <linusw@kernel.org>
 M:	Luiz Angelo Daros de Luca <luizluca@gmail.com>
--- a/arch/mips/Kconfig
+++ b/arch/mips/Kconfig
@@ -713,6 +713,32 @@ config MACH_REALTEK_RTL
 	select PINCTRL
 	select USE_OF
 	select REALTEK_OTTO_TIMER
+config MACH_REALTEK_RTL819X
+	bool "Realtek RTL819x based machines"
+	select MIPS_GENERIC
+	select MACH_GENERIC_CORE
+	select DMA_NONCOHERENT
+	select IRQ_MIPS_CPU
+	select CSRC_R4K
+	select SYS_HAS_CPU_MIPS32_R2
+	select REALTEK_RTL819X_TIMER
+	select SYS_SUPPORTS_32BIT_KERNEL
+	select SYS_SUPPORTS_LITTLE_ENDIAN
+	select SYS_SUPPORTS_MIPS16
+	select BOOT_RAW
+	select USE_OF
+	select COMMON_CLK
+	select IRQ_REALTEK_RTL819X
+	select HAVE_PCI
+	select BUILTIN_DTB if MIPS_NO_APPENDED_DTB
+	select USB_EHCI_BIG_ENDIAN_DESC if USB_SUPPORT
+	select USB_OHCI_BIG_ENDIAN_DESC if USB_SUPPORT
+	help
+	  Realtek RTL819x wireless router SoCs, currently the RTL8197F
+	  (little-endian MIPS 24KEc).  Like the RTL83xx/93xx (Otto) line,
+	  these use the generic MIPS platform with a device tree; the SoC
+	  peripherals are brought up by their own drivers.
+
 
 config SGI_IP22
 	bool "SGI IP22 (Indy/Indigo2)"
