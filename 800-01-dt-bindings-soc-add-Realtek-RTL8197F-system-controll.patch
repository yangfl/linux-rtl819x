From 1bd5899e4b08b875c60166da6fabe00e812ddc5f Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Tue, 29 Sep 2026 18:08:12 +0800
Subject: [PATCH 1/2] dt-bindings: soc: add Realtek RTL8197F system controller

Document the RTL8197F system controller: a collection of SoC-wide
registers (pin muxing, bus and clock gates, strap options) exposed as
a syscon, reached by the USB PHY and PCIe host drivers for the few
registers they need.

The node is also a simple-mfd parent: the clock controller lives inside
the same register block, so the binding describes it as a child at reg =
<0x0 0x68> (straps at 0x08, the clock gates at 0x10 and 0x64) instead of
as a second device with its own range.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../soc/realtek/realtek,rtl8197f-syscon.yaml       |   64 ++++++++++++++++++++
 1 file changed, 64 insertions(+)
 create Documentation/devicetree/bindings/soc/realtek/realtek,rtl8197f-syscon.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/realtek/realtek,rtl8197f-syscon.yaml
@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/realtek/realtek,rtl8197f-syscon.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTL8197F system controller
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |
+  The RTL8197F system controller bundles miscellaneous SoC-wide registers
+  (pin multiplexing, bus and clock gates, strap options) behind a single
+  register window at 0x18000000.  It is exposed as a syscon so that
+  drivers for blocks without a dedicated region of their own (USB PHY,
+  PCIe) can reach the few registers they need.
+
+properties:
+  compatible:
+    items:
+      - const: realtek,rtl8197f-syscon
+      - const: syscon
+      - const: simple-mfd
+
+  reg:
+    maxItems: 1
+
+  "#address-cells":
+    const: 1
+
+  "#size-cells":
+    const: 1
+
+  ranges:
+    maxItems: 1
+
+patternProperties:
+  '^clock-controller@[0-9a-f]+$':
+    $ref: /schemas/clock/realtek,rtl8197f-clock.yaml
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    syscon@0 {
+        compatible = "realtek,rtl8197f-syscon", "syscon",
+                     "simple-mfd";
+        reg = <0x0 0x200>;
+        #address-cells = <1>;
+        #size-cells = <1>;
+        ranges = <0x0 0x0 0x200>;
+
+        clock-controller@0 {
+            compatible = "realtek,rtl8197f-clock";
+            reg = <0x0 0x68>;
+            #clock-cells = <1>;
+        };
+    };
+...
