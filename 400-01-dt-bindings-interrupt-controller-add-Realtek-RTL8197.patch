From 5206117939cf9f4d2b1d68044278286c2b0d2ee7 Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Mon, 21 Sep 2026 04:08:05 +0800
Subject: [PATCH 1/2] dt-bindings: interrupt-controller: add Realtek RTL8197F intc

The RTL8197F (Realtek RTL819x MIPS router SoC family) cascades its 64
peripheral interrupt inputs through two 32-bit mask/status banks into
the MIPS CPU interrupt controller.  Add the binding for the secondary
interrupt controller, described the way the Otto "realtek,rtl-intc"
binding does it: the node takes up to five parent interrupts (the CPU
IP lines it may drive) and hands out two-cell specifiers <input
output>, where the second cell names the entry of the node's
"interrupts" list whose CPU line the input is wired to.  All inputs
are level-high and no trigger-type configuration is provided, so the
second cell is a routing index, not a flag.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../realtek,rtl8197f-intc.yaml                     |   80 ++++++++++++++++++++
 1 file changed, 80 insertions(+)
 create Documentation/devicetree/bindings/interrupt-controller/realtek,rtl8197f-intc.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/interrupt-controller/realtek,rtl8197f-intc.yaml
@@ -0,0 +1,80 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/interrupt-controller/realtek,rtl8197f-intc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTL819x SoC interrupt controller
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |
+  Secondary interrupt controller found in the Realtek RTL819x MIPS router
+  SoCs (RTL8197F and relatives), cascaded into a MIPS CPU interrupt
+  controller (mti,cpu-interrupt-controller).  It has 64 inputs, split into
+  two banks of 32, each with its own mask (GIMR/GIMR2) and status
+  (GISR/GISR2) register.  Bank 1 is aggregated onto bank 0 input 31, which
+  is therefore reserved and not usable as a regular interrupt.
+
+  Eight routing registers (IRR0-IRR7) assign each input to one of the six
+  MIPS CPU interrupt lines IP2-IP7; the routing of an input is selected by
+  the second cell of its interrupt specifier.  The node must list one
+  parent interrupt for every CPU line that routed inputs land on: on the
+  RTL8197F these are IP2 (generic sources), IP4 (switch core), IP5 (PCIe),
+  IP6 (WLAN MAC) and IP7 (CPU SI timer).
+
+allOf:
+  - $ref: /schemas/interrupt-controller.yaml#
+
+properties:
+  compatible:
+    const: realtek,rtl8197f-intc
+
+  reg:
+    maxItems: 1
+
+  interrupt-controller: true
+
+  "#address-cells":
+    const: 0
+
+  "#interrupt-cells":
+    const: 2
+    description: |
+      The first cell is the interrupt input number (0-63, input 31
+      reserved).  The second cell is the index of the parent interrupt in
+      "interrupts" whose CPU line the input is wired to; inputs are
+      level-high, no trigger-type configuration is provided.
+
+  interrupts:
+    minItems: 1
+    maxItems: 5
+    description:
+      The MIPS CPU interrupt lines this controller feeds, in the order
+      referenced by the second cell of the interrupt specifiers.
+
+required:
+  - compatible
+  - reg
+  - interrupt-controller
+  - "#interrupt-cells"
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    rtl8197f_intc: interrupt-controller@3000 {
+        compatible = "realtek,rtl8197f-intc";
+        reg = <0x3000 0x40>;
+        interrupt-controller;
+        #interrupt-cells = <2>;
+        interrupt-parent = <&cpuintc>;
+        interrupts = <2>, <4>, <5>, <6>, <7>;
+    };
+
+    device {
+        interrupt-parent = <&rtl8197f_intc>;
+        interrupts = <9 0>; /* UART0, routed to the first parent (IP2) */
+    };
