From d8a534f43b5f7e5e0786a0098b5dfc4425c41821 Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Fri, 9 Oct 2026 03:40:18 +0800
Subject: [PATCH 11/19] wifi: rtl8192f-soc: track the initial gain from the
 false-alarm counters

The BB init table leaves 0xc50 at one static value, so the receiver keeps
the same gain whether the channel is clean or full of interference.  The
vendor adjusts it continuously in phydm's DIG loop; port the part of that
loop a host driver can own:

 - sample the false-alarm counters the way
   odm_FalseAlarmCounterStatistics() does for an 11N-series part
   (phydm_dig.c 2694-2760): hold page C
   (0xc00 bit31) and page D (0xd00 bit31) plus the two CCK holds (0xa2c
   bits 12 and 14), read the six OFDM bins the vendor sums into
   Cnt_Ofdm_fail - the low half of 0xda0 is a busy-channel count and stays
   out of that sum (phydm_dig.c 2715-2718) - and add the 16-bit CCK FA
   counter assembled from 0xa5c and 0xa58.  Then pulse the resets and drop
   the holds (phydm_dig.c 2959-3030) so the next sample counts one period,
   not everything since boot.
 - move the gain code by the vendor's ladder and step triple
   (phydm_dig.c 2598-2605, 931-934) inside the 1T1R 2.4G window: upper
   bound DM_DIG_MAX_AP-6 = 0x38 (phydm_dig.c 1083-1086) and the 8197F lower
   bound 0x1e (phydm_dig.c 1090-1091).
 - run it on the same tick the vendor's watchdog uses, and seed the state
   from 0xc50 as the vendor's initialisation does.

The rest of DIG is deliberately not ported because each piece needs state
this host path does not have: the RSSI-driven narrowing of the bounds, the
TDMA dual-gain machine, the CCK packet-detect and CS-ratio ladder
(0xa08[19:16], 0xaa8[20:16]) and the AGC table switching.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../net/wireless/realtek/rtl8192f-soc/core.c  |   4 +
 .../net/wireless/realtek/rtl8192f-soc/hw.c    | 114 ++++++++++++++++++
 .../realtek/rtl8192f-soc/rtl8192f_soc.h       |  37 ++++++
 3 files changed, 155 insertions(+)

--- a/drivers/net/wireless/realtek/rtl8192f-soc/core.c
+++ b/drivers/net/wireless/realtek/rtl8192f-soc/core.c
@@ -145,6 +145,8 @@ static int rtl8192f_start(struct ieee802
 		rtl8192f_set_channel(priv, priv->cur_channel,
 				     priv->cur_chan_type);
 
+	rtl8192f_dig_start(priv);
+
 	ieee80211_wake_queues(hw);
 
 	rtl8192f_tx_watch_start(priv);
@@ -161,6 +163,7 @@ static void rtl8192f_stop(struct ieee802
 	mutex_lock(&priv->conf_mutex);
 
 	rtl8192f_tx_watch_stop(priv);
+	rtl8192f_dig_stop(priv);
 
 	ieee80211_stop_queues(hw);
 	rtl8192f_write16(priv, REG_CR,
@@ -788,6 +791,7 @@ static int rtl8192f_soc_probe(struct pla
 	mutex_init(&priv->h2c_mutex);
 	mutex_init(&priv->conf_mutex);
 	INIT_DELAYED_WORK(&priv->tx_watch, rtl8192f_tx_watch);
+	INIT_DELAYED_WORK(&priv->dig_work, rtl8192f_dig_work);
 
 	priv->regs = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(priv->regs)) {
--- a/drivers/net/wireless/realtek/rtl8192f-soc/hw.c
+++ b/drivers/net/wireless/realtek/rtl8192f-soc/hw.c
@@ -878,6 +878,120 @@ int rtl8192f_hw_init(struct rtl8192f_soc
 /* TX power                                                            */
 
 /* ------------------------------------------------------------------ */
+/* Dynamic initial gain                                                */
+/* ------------------------------------------------------------------ */
+/* Count the false alarms of one period.  The vendor holds both counter pages
+ * and the CCK counters before reading, then pulses the resets and drops the
+ * holds (phydm_dig.c 2959-3030); without that the next period would report a
+ * running total instead of its own.  The OFDM bins are the six the vendor
+ * sums into Cnt_Ofdm_fail - the low half of 0xda0 is a busy-channel count and
+ * stays out of it (phydm_dig.c 2715-2718) - and the CCK side is the 16-bit FA
+ * counter split across 0xa5c (low byte) and 0xa58 (high byte), assembled as at
+ * phydm_dig.c 2747-2753.
+ */
+static u32 rtl8192f_dig_fa_count(struct rtl8192f_soc_priv *priv)
+{
+	u32 val, ofdm, cck;
+
+	rtl8192f_rmw_bb(priv, REG_FA_OFDM_HOLD, BIT(31), BIT(31));
+	rtl8192f_rmw_bb(priv, REG_FA_OFDM_RESET2, BIT(31), BIT(31));
+	rtl8192f_rmw_bb(priv, REG_FA_CCK_CTRL, BIT(12), BIT(12));
+	rtl8192f_rmw_bb(priv, REG_FA_CCK_CTRL, BIT(14), BIT(14));
+
+	val = rtl8192f_read32(priv, REG_FA_OFDM_SYNC);
+	ofdm = FIELD_GET(GENMASK(15, 0), val) + FIELD_GET(GENMASK(31, 16), val);
+
+	val = rtl8192f_read32(priv, REG_FA_OFDM_CCA);
+	ofdm += FIELD_GET(GENMASK(31, 16), val);
+
+	val = rtl8192f_read32(priv, REG_FA_OFDM_HDR);
+	ofdm += FIELD_GET(GENMASK(15, 0), val) + FIELD_GET(GENMASK(31, 16), val);
+
+	val = rtl8192f_read32(priv, REG_FA_OFDM_MCS);
+	ofdm += FIELD_GET(GENMASK(15, 0), val);
+
+	cck = FIELD_GET(GENMASK(7, 0), rtl8192f_read32(priv, REG_FA_CCK_LOW)) +
+	      (FIELD_GET(GENMASK(31, 24), rtl8192f_read32(priv, REG_FA_CCK_HIGH))
+	       << 8);
+
+	rtl8192f_rmw_bb(priv, REG_FA_OFDM_RESET, BIT(31), BIT(31));
+	rtl8192f_rmw_bb(priv, REG_FA_OFDM_RESET, BIT(31), 0);
+	rtl8192f_rmw_bb(priv, REG_FA_OFDM_RESET2, BIT(27), BIT(27));
+	rtl8192f_rmw_bb(priv, REG_FA_OFDM_RESET2, BIT(27), 0);
+	rtl8192f_rmw_bb(priv, REG_FA_OFDM_HOLD, BIT(31), 0);
+	rtl8192f_rmw_bb(priv, REG_FA_OFDM_RESET2, BIT(31), 0);
+	rtl8192f_rmw_bb(priv, REG_FA_CCK_CTRL, BIT(13) | BIT(12), 0);
+	rtl8192f_rmw_bb(priv, REG_FA_CCK_CTRL, BIT(13) | BIT(12), BIT(13));
+	rtl8192f_rmw_bb(priv, REG_FA_CCK_CTRL, BIT(15) | BIT(14), 0);
+	rtl8192f_rmw_bb(priv, REG_FA_CCK_CTRL, BIT(15) | BIT(14), BIT(15));
+
+	return ofdm + cck;
+}
+
+/* One DIG step: trade the initial gain against the measured false-alarm
+ * rate.  Above the middle threshold the gain code goes up, below the low
+ * threshold it comes back down, and the code stays inside the vendor's
+ * 1T1R 2.4G window.  The direction of the arithmetic is the SDK's
+ * (phydm_dig.c 2598-2605), not a re-derivation: 0xc50 counts the other
+ * way from what the name suggests, and the shipped radio is the
+ * reference for which way is "less sensitive".
+ *
+ * Left out on purpose, because each needs state this host path does not
+ * have: the RSSI-driven narrowing of the bounds, the TDMA dual-gain
+ * machine, the CCK packet-detect/CS-ratio ladder (0xa08[19:16],
+ * 0xaa8[20:16]) and the AGC table switching.  Their absence is why a
+ * quiet channel still sits at the initial value: only the false-alarm
+ * term drives the loop here.
+ */
+void rtl8192f_dig_work(struct work_struct *work)
+{
+	struct rtl8192f_soc_priv *priv =
+		container_of(to_delayed_work(work), struct rtl8192f_soc_priv,
+			     dig_work);
+	u32 fa;
+	u8 igi;
+
+	if (!priv->hw_ready)
+		return;
+
+	fa = rtl8192f_dig_fa_count(priv);
+	igi = priv->dig_igi;
+
+	if (fa > DIG_FA_TH_HIGH)
+		igi += DIG_FA_STEP_HIGH;
+	else if (fa > DIG_FA_TH_MID)
+		igi += DIG_FA_STEP_MID;
+	else if (fa < DIG_FA_TH_LOW)
+		igi -= DIG_FA_STEP_LOW;
+
+	igi = clamp_t(u8, igi, DIG_IGI_MIN, DIG_IGI_MAX);
+	if (igi != priv->dig_igi) {
+		priv->dig_igi = igi;
+		rtl8192f_rmw_bb(priv, REG_INITIAL_GAIN, 0xff, igi);
+	}
+
+	schedule_delayed_work(&priv->dig_work,
+			      msecs_to_jiffies(DIG_PERIOD_MS));
+}
+
+/* Seed the state from the value the BB init table left in 0xc50 - the same
+ * place the vendor's DIG initialisation reads - and clear the counters so the
+ * first sample covers one period only.
+ */
+void rtl8192f_dig_start(struct rtl8192f_soc_priv *priv)
+{
+	priv->dig_igi = rtl8192f_read32(priv, REG_INITIAL_GAIN) & 0xff;
+	rtl8192f_dig_fa_count(priv);
+	schedule_delayed_work(&priv->dig_work,
+			      msecs_to_jiffies(DIG_PERIOD_MS));
+}
+
+void rtl8192f_dig_stop(struct rtl8192f_soc_priv *priv)
+{
+	cancel_delayed_work_sync(&priv->dig_work);
+}
+
+/* ------------------------------------------------------------------ */
 /* Channel switching                                                   */
 /* ------------------------------------------------------------------ */
 
--- a/drivers/net/wireless/realtek/rtl8192f-soc/rtl8192f_soc.h
+++ b/drivers/net/wireless/realtek/rtl8192f-soc/rtl8192f_soc.h
@@ -849,6 +849,8 @@ struct rtl8192f_soc_priv {
 	bool running;
 	u32 cur_channel;
 	enum nl80211_channel_type cur_chan_type;
+	u8 dig_igi;
+	struct delayed_work dig_work;
 
 	/* interface state (single-vif for now) */
 	struct ieee80211_vif *vif;
@@ -1024,7 +1026,42 @@ void rtl8192f_bss_info_changed(struct ie
  */
 
 int rtl8192f_hw_power_on(struct rtl8192f_soc_priv *priv);
+/* Dynamic initial gain (DIG).  The 8197F executes phydm's 11N branch, so the
+ * counters and the hold/reset bits are the 11N set: addresses from
+ * phydm_regdefine11n.h 101-183, the read bin layout from phydm_dig.c
+ * 2700-2753 and the hold/reset order from phydm_dig.c 2959-3030.
+ */
+#define REG_FA_CCK_CTRL			0x0A2C	/* CCK FA/CCA hold + reset */
+#define REG_FA_CCK_HIGH			0x0A58	/* CCK FA counter, bits 15:8 */
+#define REG_FA_CCK_LOW			0x0A5C	/* CCK FA counter, bits 7:0 */
+#define REG_FA_OFDM_HOLD		0x0C00	/* page C hold, bit31 */
+#define REG_FA_OFDM_RESET		0x0C0C	/* page C reset, bit31 */
+#define REG_INITIAL_GAIN		0x0C50	/* byte0 = initial gain code */
+#define REG_FA_OFDM_SYNC		0x0CF0	/* fast sync / server board search */
+#define REG_FA_OFDM_RESET2		0x0D00	/* page D hold bit31, reset bit27 */
+#define REG_FA_OFDM_CCA			0x0DA0	/* OFDM CCA (low) / parity fail */
+#define REG_FA_OFDM_HDR			0x0DA4	/* rate illegal / crc8 fail */
+#define REG_FA_OFDM_MCS			0x0DA8	/* mcs fail (low half) */
+
+/* Bounds and ladder for this radio as the vendor sets them: 1T1R takes
+ * DM_DIG_MAX_AP-6 = 0x38 (phydm_dig.c 1083-1086), the 8197F lower bound is
+ * 0x1e (phydm_dig.c 1090-1091), the AP-side FA thresholds are 0x100/0x200/0x300
+ * (phydm_dig.c 116-118) and the step triple is 2/1/2 (phydm_dig.c 931-934).
+ */
+#define DIG_IGI_MAX			0x38
+#define DIG_IGI_MIN			0x1e
+#define DIG_FA_STEP_HIGH		2
+#define DIG_FA_STEP_MID			1
+#define DIG_FA_STEP_LOW			2
+#define DIG_FA_TH_LOW			0x100
+#define DIG_FA_TH_MID			0x200
+#define DIG_FA_TH_HIGH			0x300
+#define DIG_PERIOD_MS			2000
+
 int rtl8192f_hw_init(struct rtl8192f_soc_priv *priv);
+void rtl8192f_dig_work(struct work_struct *work);
+void rtl8192f_dig_start(struct rtl8192f_soc_priv *priv);
+void rtl8192f_dig_stop(struct rtl8192f_soc_priv *priv);
 int rtl8192f_hw_fifo_init(struct rtl8192f_soc_priv *priv);
 int rtl8192f_fw_download(struct rtl8192f_soc_priv *priv);
 int rtl8192f_h2c_send(struct rtl8192f_soc_priv *priv, u8 id,
