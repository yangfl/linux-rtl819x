From c087f258a570267203b5887ba34bfc973e9daa40 Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Mon, 21 Sep 2026 04:08:10 +0800
Subject: [PATCH 1/2] dt-bindings: phy: add Realtek RTL8197F USB2 PHY

The RTL8197F has two UTMI PHYs feeding the OHCI/EHCI host
controllers, powered and reset through the system controller and
tuned through an indirect register access with a strobe in the EHCI
MMIO space.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../bindings/phy/realtek,rtl8197f-usbphy.yaml | 63 +++++++++++++++++++
 1 file changed, 63 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/realtek,rtl8197f-usbphy.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/realtek,rtl8197f-usbphy.yaml
@@ -0,0 +1,63 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/realtek,rtl8197f-usbphy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTL819x USB 2.0 PHY
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |
+  The RTL8197F (and other RTL819x SoCs) integrate two UTMI USB 2.0 PHYs.
+  Both PHYs are shared by the on-chip EHCI and OHCI host controllers; PHY 1
+  can alternatively be routed to the DWC OTG device controller.  Power and
+  reset of the PHYs is controlled through the system controller, while the
+  electrical parameters are written through an indirect access port made of
+  a data register in the USB analog block and an address strobe register
+  inside the EHCI MMIO space.
+
+properties:
+  compatible:
+    const: realtek,rtl8197f-usbphy
+
+  reg:
+    items:
+      - description: USB analog block registers (UTMI data / port control)
+      - description: UTMI address strobe register (EHCI MMIO offset 0xa4)
+
+  reg-names:
+    items:
+      - const: analog
+      - const: utmi-acc
+
+  syscon:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle to the system controller node (realtek,rtl8197f-syscon),
+      providing the USB clock gate, host enable, PHY power/reset and SIE
+      routing registers.
+
+  "#phy-cells":
+    const: 1
+    description: The USB port (UTMI PHY) index, 0 or 1.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - syscon
+  - "#phy-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    usb-phy@140200 {
+        compatible = "realtek,rtl8197f-usbphy";
+        reg = <0x140200 0x18>, <0x210a4 0x4>;
+        reg-names = "analog", "utmi-acc";
+        syscon = <&syscon>;
+        #phy-cells = <1>;
+    };
