From 4e5729bcd23bd55f774c746a3809562c1e1c3933 Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Mon, 21 Sep 2026 04:08:03 +0800
Subject: [PATCH 2/3] dt-bindings: mips: document Realtek RTL819x SoC series

Document the root compatibles for the Realtek RTL819x wireless router
SoCs, starting with the RTL8197F, and the one in-tree board (Netcore MG1200AC) alongside it.

The family is kept separate from realtek-rtl.yaml, which covers the
RTL83xx/93xx (Otto) switch SoCs: the two lines share the vendor but not
the CPU core, interrupt controller or peripheral register layouts.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../bindings/mips/realtek-rtl819x.yaml        | 28 +++++++++++++++++++
 1 file changed, 28 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/mips/realtek-rtl819x.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/mips/realtek-rtl819x.yaml
@@ -0,0 +1,28 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mips/realtek-rtl819x.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Realtek RTL819x SoC series
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |
+  The RTL819x family are Realtek's wireless router SoCs, based on a
+  little-endian MIPS 24KEc class CPU, distinct from the RTL83xx/93xx
+  (Otto) switch SoC series.
+
+properties:
+  $nodename:
+    const: "/"
+  compatible:
+    oneOf:
+      # RTL8197F-based boards
+      - items:
+          - enum:
+              - netcore,mg1200ac
+          - const: realtek,rtl8197f-soc
+
+additionalProperties: true
